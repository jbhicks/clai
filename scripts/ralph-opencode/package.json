{
  "name": "@clai/ralph-opencode",
  "version": "1.0.0",
  "description": "Fancy Ralph-driven development loop with OhMyOpenCode multi-agent orchestration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ralph-omo": "./bin/ralph-omo.js"
  },
  "scripts": {
    "build": "bun build --compile --outfile=bin/ralph-omo.js src/index.ts",
    "dev": "bun run --watch src/index.ts",
    "test": "bun test",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0",
    "figures": "^3.2.0",
    "jose": "^5.9.0",
    "ora": "^8.1.0",
    "zx": "^8.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "@types/cli-progress": "^3.11.0",
    "bun-types": "^1.1.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": [
    "ralph",
    "autonomous",
    "agent",
    "oh-my-opencode",
    "opencode",
    "sisyphus",
    "loop",
    "development"
  ],
  "author": "CLAI Team",
  "license": "MIT"
}

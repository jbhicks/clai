package templates

templ Servers() {
	@Layout("Model Servers") {
		<!-- GPU Status Dashboard -->
		<div 
			id="gpu_status"
			hx-get="/api/gpu/status"
			hx-trigger="load, every 3s"
			hx-swap="morph:outerHTML"
			hx-ext="morph"
		>
			<div style="background: #1e293b; border: 1px solid #334155; border-radius: 8px; padding: 12px 20px; margin-bottom: 20px;">
				<span style="color: #94a3b8; font-size: 13px;">Loading GPU status...</span>
			</div>
		</div>

		<div class="card">
			<h2 style="margin-bottom: 20px; font-size: 24px;">Model Server Management</h2>
			<p style="margin-bottom: 20px; color: #cbd5e1;">
				Start and stop model servers. Each model requires its own server process on a unique port (8081-8090).
			</p>
			
		<div 
			id="servers_list" 
			hx-get="/api/servers/list" 
			hx-trigger="load, every 3s"
			hx-swap="morph:outerHTML"
			hx-ext="morph"
		>
			<p style="color: #94a3b8;">Loading servers...</p>
		</div>
		</div>
		
		<div class="card">
			<h3 style="margin-bottom: 15px; font-size: 18px;">Agentic Benchmark Results</h3>
			<p style="margin-bottom: 15px; color: #cbd5e1; font-size: 14px;">
				These benchmarks test if models can write executable Go code to solve tasks.
			</p>
			<div id="benchmark_results"></div>
			<div 
				id="benchmark_results_table"
				hx-get="/api/benchmark/results"
				hx-trigger="load, every 5s"
				hx-swap="morph:outerHTML"
				hx-ext="morph"
			>
				<p style="color: #94a3b8;">Loading...</p>
			</div>
		</div>
		
		<div class="card">
			<h3 style="margin-bottom: 15px; font-size: 18px;">Test Results (Quick Tests)</h3>
			<div id="test_results"></div>
			<div 
				id="test_results_table"
				hx-get="/api/test/results"
				hx-trigger="load, reload from:body"
				hx-swap="innerHTML"
			>
				<p style="color: #94a3b8;">Loading...</p>
			</div>
		</div>
		
		<div class="card">
			<h3 style="margin-bottom: 15px; font-size: 18px;">About Server Management</h3>
			<p style="margin-bottom: 10px; color: #cbd5e1;">
				Each model server:
			</p>
			<ul style="margin-left: 20px; color: #cbd5e1; line-height: 2;">
				<li>Loads one model into GPU memory</li>
				<li>Takes 30-60 seconds to start (large models)</li>
				<li>Uses ~20GB VRAM for 30B models</li>
				<li>Runs on a unique port (8081-8090)</li>
				<li>Stays running until manually stopped</li>
			</ul>
			<p style="margin-top: 15px; color: #cbd5e1;">
				Tip: Keep frequently-used models running. Stop unused models to free VRAM.
			</p>
		</div>
	}
}

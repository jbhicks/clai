package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
	<head>
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>{title} - clai Benchmarks</title>
	<!-- HTMX 2.0.8 with SSE 2.2.4 - Correct versions for SSE extension -->
	<script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.8/dist/htmx.min.js" integrity="sha384-/TgkGk7p307TH7EXJDuUlgG3Ce1UVolAOFopFekQkkXihi5u/6OCvVKyz1W+idaz" crossorigin="anonymous"></script>
	<!-- Wrapper via external script (loads before SSE, won't be reordered by templ) -->
	<script src="/static/htmx-wrapper.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/htmx-ext-sse@2.2.4/sse.js" integrity="sha384-QA9wXqexhwzXTuTvuF5QP82pddm3R2hy81UzXi7ioNTqNF2b75hlkkSGjafohhL3" crossorigin="anonymous"></script>
	<script src="https://unpkg.com/idiomorph@0.3.0/dist/idiomorph-ext.min.js"></script>
	<style>
			/* ===================================
			   CLAI BENCHMARKS - ENHANCED UI
			   Based on media-manager glassmorphism
			   =================================== */
			
			/* CSS Variables - Design System */
			:root {
				/* Background Colors */
				--bg-primary: #0d1117;
				--bg-secondary: #161b22;
				--bg-tertiary: #21262d;
				--bg-card: #1c2128;
				--bg-card-hover: #262c36;
				--bg-glass: rgba(22, 27, 34, 0.8);
				--bg-glass-border: rgba(48, 54, 61, 0.5);
				
				/* Text Colors */
				--text-primary: #f0f6f8;
				--text-secondary: #8b949e;
				--text-muted: #6e7681;
				
				/* Accent Colors */
				--accent-primary: #58a6ff;
				--accent-secondary: #8b949e;
				--accent-cyan: #39d0d8;
				--accent-green: #3fb950;
				--accent-yellow: #d29922;
				--accent-red: #f85149;
				--accent-orange: #f97316;
				
				/* Gradients */
				--gradient-primary: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
				--gradient-success: linear-gradient(135deg, #3fb950 0%, #1f883d 100%);
				--gradient-danger: linear-gradient(135deg, #f85149 0%, #da3633 100%);
				--gradient-warning: linear-gradient(135deg, #d29922 0%, #bf8700 100%);
				
				/* Spacing */
				--space-xs: 4px;
				--space-sm: 8px;
				--space-md: 16px;
				--space-lg: 24px;
				--space-xl: 32px;
				--space-2xl: 48px;
				
				/* Border Radius */
				--radius-sm: 4px;
				--radius-md: 8px;
				--radius-lg: 12px;
				--radius-xl: 16px;
				
				/* Shadows */
				--shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.12);
				--shadow-md: 0 4px 6px rgba(0, 0, 0, 0.16);
				--shadow-lg: 0 10px 25px rgba(0, 0, 0, 0.2);
				--shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.3);
				--shadow-glow: 0 0 20px rgba(102, 126, 234, 0.4);
				
				/* Transitions */
				--transition-fast: all 0.15s ease;
				--transition-normal: all 0.3s ease;
				--transition-slow: all 0.5s ease;
			}
			
			/* Base Styles */
			* { margin: 0; padding: 0; box-sizing: border-box; }
			body {
				font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
				background: var(--bg-primary);
				color: var(--text-primary);
				line-height: 1.6;
				min-height: 100vh;
				overflow-x: hidden;
			}
			
			/* Animated Background */
			body::before {
				content: '';
				position: fixed;
				top: 0;
				left: 0;
				width: 100%;
				height: 100%;
				background: 
					radial-gradient(circle at 20% 50%, rgba(99, 102, 241, 0.1) 0%, transparent 50%),
					radial-gradient(circle at 80% 80%, rgba(139, 92, 246, 0.1) 0%, transparent 50%),
					radial-gradient(circle at 40% 20%, rgba(236, 72, 153, 0.1) 0%, transparent 50%);
				z-index: -1;
				animation: backgroundFloat 20s ease-in-out infinite;
			}
			
			@keyframes backgroundFloat {
				0%, 100% { transform: translate(0, 0) rotate(0deg); }
				33% { transform: translate(-20px, -20px) rotate(1deg); }
				66% { transform: translate(20px, -10px) rotate(-1deg); }
			}
			
			/* View Transitions API - Smooth page transitions */
			@keyframes fade-in {
				from { opacity: 0; }
			}
			@keyframes fade-out {
				to { opacity: 0; }
			}
			@keyframes slide-from-right {
				from { transform: translateX(90px); }
			}
			@keyframes slide-to-left {
				to { transform: translateX(-90px); }
			}
			@keyframes slide-from-bottom {
				from { transform: translateY(20px); opacity: 0; }
			}
			@keyframes scale-in {
				from { transform: scale(0.95); opacity: 0; }
			}
			
			/* Apply view transitions to main content */
			.page-content {
				view-transition-name: page-content;
			}
			::view-transition-old(page-content) {
				animation: 180ms cubic-bezier(0.4, 0, 1, 1) both fade-out,
				           300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-to-left;
			}
			::view-transition-new(page-content) {
				animation: 320ms cubic-bezier(0, 0, 0.2, 1) 90ms both fade-in,
				           300ms cubic-bezier(0.4, 0, 0.2, 1) both slide-from-right;
			}
			
			/* Card entrance animation */
			.card {
				animation: slide-from-bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1);
			}
			
			/* HTMX Loading States */
			.htmx-indicator {
				display: none;
			}
			.htmx-request .htmx-indicator,
			.htmx-request.htmx-indicator {
				display: inline-block;
			}
			
			/* Swapping animations */
			.htmx-swapping {
				opacity: 0;
				transition: opacity 200ms ease-out;
			}
			.htmx-settling {
				animation: fade-in 300ms ease-in;
			}
			.htmx-added {
				animation: slide-from-bottom 400ms cubic-bezier(0.16, 1, 0.3, 1);
			}
			
			/* Pulse loading animation */
			@keyframes pulse {
				0%, 100% { opacity: 1; }
				50% { opacity: 0.5; }
			}
			.loading-pulse {
				animation: pulse 1.5s cubic-bezier(0.4, 0, 0.6, 1) infinite;
			}
			
			/* Skeleton loader */
			@keyframes skeleton-loading {
				0% { background-position: -200% 0; }
				100% { background-position: 200% 0; }
			}
			.skeleton {
				background: linear-gradient(
					90deg,
					#1e293b 0%,
					#334155 50%,
					#1e293b 100%
				);
				background-size: 200% 100%;
				animation: skeleton-loading 1.5s ease-in-out infinite;
				border-radius: 4px;
			}
			
			/* Spinner */
			@keyframes spin {
				to { transform: rotate(360deg); }
			}
			.spinner {
				width: 16px;
				height: 16px;
				border: 2px solid #475569;
				border-top-color: #667eea;
				border-radius: 50%;
				animation: spin 0.6s linear infinite;
				display: inline-block;
				vertical-align: middle;
			}
			
			/* Beautiful Progress Bars */
			.progress-container {
				margin: var(--space-md) 0;
				position: relative;
			}
			
			.progress-bar {
				width: 100%;
				height: 8px;
				background: var(--bg-tertiary);
				border-radius: var(--radius-lg);
				overflow: hidden;
				position: relative;
			}
			
			.progress-fill {
				height: 100%;
				background: var(--gradient-primary);
				border-radius: var(--radius-lg);
				transition: width 0.5s ease;
				position: relative;
				overflow: hidden;
			}
			
			.progress-fill::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
				animation: progressShine 2s infinite;
			}
			
			@keyframes progressShine {
				0% { left: -100%; }
				100% { left: 100%; }
			}
			
			.progress-text {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-top: var(--space-xs);
				font-size: 0.8rem;
				color: var(--text-secondary);
			}
			
			.progress-speed {
				color: var(--accent-cyan);
				font-weight: 600;
			}
			
			/* Table row animations */
			tbody tr {
				transition: background-color 0.15s ease, transform 0.15s ease;
			}
			tbody tr:hover {
				background: #2d3748;
				transform: translateX(2px);
			}
			tbody tr.htmx-swapping td {
				opacity: 0;
				transform: translateX(-20px);
				transition: opacity 0.3s ease-out, transform 0.3s ease-out;
			}
			
			/* Result details slide-in */
			.result-details {
				animation: slide-from-bottom 0.3s cubic-bezier(0.16, 1, 0.3, 1);
			}
			
			/* Button press animation */
			.btn {
				transition: transform 0.1s ease, box-shadow 0.1s ease;
			}
			.btn:active {
				transform: scale(0.98);
			}
			.btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
			}
			
			/* Toast notification slide-in */
			.toast {
				position: fixed;
				top: 20px;
				right: 20px;
				background: #1e293b;
				border: 1px solid #667eea;
				border-radius: 8px;
				padding: 16px;
				box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);
				animation: slide-from-right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
				z-index: 1000;
			}
			
			/* Container */
			.container {
				max-width: 1400px;
				margin: 0 auto;
				padding: var(--space-lg);
			}
			
			/* Page Content - for view transitions */
			.page-content {
				view-transition-name: page-content;
			}
			/* Glassmorphism Header */
			.header {
				backdrop-filter: blur(16px) saturate(180%);
				-webkit-backdrop-filter: blur(16px) saturate(180%);
				background-color: rgba(22, 27, 34, 0.75);
				border: 1px solid rgba(48, 54, 61, 0.3);
				border-radius: var(--radius-xl);
				padding: var(--space-md) var(--space-lg);
				margin-bottom: var(--space-lg);
				box-shadow: 
					0 8px 32px 0 rgba(0, 0, 0, 0.37),
					inset 0 1px 0 0 rgba(255, 255, 255, 0.05);
			}
			.header h1 {
				font-size: 24px;
				margin-bottom: 4px;
				font-weight: 600;
				color: var(--text-primary);
			}
			.header p {
				opacity: 0.9;
				font-size: 13px;
				margin: 0;
				color: var(--text-secondary);
			}
			/* Glassmorphism Navigation */
			.nav {
				display: flex;
				gap: var(--space-sm);
				margin-bottom: var(--space-lg);
				border-bottom: 1px solid rgba(48, 54, 61, 0.3);
				padding: 0;
			}
			.nav a {
				padding: 8px 16px;
				background: transparent;
				color: var(--text-secondary);
				text-decoration: none;
				border-bottom: 2px solid transparent;
				transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
				font-size: 14px;
				font-weight: 500;
				position: relative;
				margin-bottom: -1px;
				
				/* Subtle glassmorphism */
				backdrop-filter: blur(8px) saturate(150%);
				-webkit-backdrop-filter: blur(8px) saturate(150%);
			}
			.nav a:hover {
				color: var(--text-primary);
				border-bottom-color: var(--text-secondary);
				background: rgba(22, 27, 34, 0.3);
				transform: translateY(-1px);
			}
			.nav a.active {
				color: var(--text-primary);
				border-bottom-color: var(--accent-orange);
				background: rgba(88, 166, 255, 0.1);
			}
			/* Glassmorphism Cards */
			.card {
				backdrop-filter: blur(16px) saturate(180%);
				-webkit-backdrop-filter: blur(16px) saturate(180%);
				background-color: rgba(22, 27, 34, 0.75);
				border: 1px solid rgba(48, 54, 61, 0.3);
				border-radius: var(--radius-xl);
				box-shadow: 
					0 8px 32px 0 rgba(0, 0, 0, 0.37),
					inset 0 1px 0 0 rgba(255, 255, 255, 0.05);
				padding: var(--space-lg);
				margin-bottom: var(--space-lg);
				transition: var(--transition-normal);
				animation: slide-from-bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1);
			}
			
			.card:hover {
				transform: translateY(-4px);
				border-color: rgba(88, 166, 255, 0.4);
				box-shadow: 
					0 12px 48px 0 rgba(0, 0, 0, 0.5),
					0 0 20px rgba(88, 166, 255, 0.15),
					inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
			}
			/* Enhanced Tables */
			table {
				width: 100%;
				border-collapse: collapse;
			}
			th {
				background: var(--bg-tertiary);
				padding: 12px;
				text-align: left;
				font-weight: 600;
				border-bottom: 2px solid rgba(48, 54, 61, 0.5);
				color: var(--text-primary);
			}
			td {
				padding: 12px;
				border-bottom: 1px solid rgba(48, 54, 61, 0.3);
				color: var(--text-primary);
			}
			tr {
				transition: var(--transition-fast);
			}
			tr:hover {
				background: rgba(38, 44, 54, 0.5);
				transform: translateX(2px);
			}
			/* Status Badges */
			.status-pass {
				color: var(--accent-green);
				font-weight: bold;
			}
			.status-fail {
				color: var(--accent-red);
				font-weight: bold;
			}
			.status-running {
				color: var(--accent-cyan);
				font-weight: bold;
			}
			.status-pending {
				color: var(--accent-yellow);
				font-weight: bold;
			}
			
			/* Status Badge Pills */
			.badge {
				display: inline-block;
				padding: 4px 12px;
				border-radius: var(--radius-lg);
				font-size: 0.75rem;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}
			.badge-success {
				background: rgba(63, 185, 80, 0.15);
				color: var(--accent-green);
				border: 1px solid rgba(63, 185, 80, 0.3);
			}
			.badge-error {
				background: rgba(248, 81, 73, 0.15);
				color: var(--accent-red);
				border: 1px solid rgba(248, 81, 73, 0.3);
			}
			.badge-warning {
				background: rgba(210, 153, 34, 0.15);
				color: var(--accent-yellow);
				border: 1px solid rgba(210, 153, 34, 0.3);
			}
			.badge-info {
				background: rgba(57, 208, 216, 0.15);
				color: var(--accent-cyan);
				border: 1px solid rgba(57, 208, 216, 0.3);
			}
			/* Glassmorphism Buttons */
			.btn {
				padding: 10px 20px;
				background: var(--gradient-primary);
				color: white;
				border: none;
				border-radius: var(--radius-md);
				cursor: pointer;
				text-decoration: none;
				display: inline-block;
				font-weight: 500;
				transition: var(--transition-normal);
				box-shadow: var(--shadow-md);
				position: relative;
				overflow: hidden;
			}
			.btn::before {
				content: '';
				position: absolute;
				top: 0;
				left: -100%;
				width: 100%;
				height: 100%;
				background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
				transition: left 0.5s ease;
			}
			.btn:hover::before {
				left: 100%;
			}
			.btn:hover {
				transform: translateY(-2px);
				box-shadow: var(--shadow-lg), var(--shadow-glow);
			}
			.btn:active {
				transform: scale(0.98);
			}
			.btn:disabled {
				opacity: 0.5;
				cursor: not-allowed;
				transform: none;
			}
			.btn-secondary {
				background: rgba(71, 85, 105, 0.6);
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
				border: 1px solid rgba(100, 116, 139, 0.3);
			}
			.btn-secondary:hover {
				background: rgba(100, 116, 139, 0.8);
				border-color: rgba(148, 163, 184, 0.5);
			}
			/* Metric Pills with Glassmorphism */
			.metric {
				display: inline-block;
				padding: 4px 12px;
				backdrop-filter: blur(8px) saturate(150%);
				-webkit-backdrop-filter: blur(8px) saturate(150%);
				background: rgba(51, 65, 85, 0.5);
				border: 1px solid rgba(71, 85, 105, 0.3);
				border-radius: var(--radius-md);
				margin-right: 10px;
				font-size: 14px;
				transition: var(--transition-fast);
			}
			.metric:hover {
				background: rgba(71, 85, 105, 0.6);
				border-color: rgba(100, 116, 139, 0.5);
				transform: translateY(-1px);
			}
			.success-high { color: var(--accent-green); }
			.success-medium { color: var(--accent-yellow); }
			.success-low { color: var(--accent-red); }
	
	/* Loading Spinner - HTMX indicator */
	.spinner {
		display: none; /* Hidden by default */
		width: 14px;
		height: 14px;
		border: 2px solid rgba(255, 255, 255, 0.3);
		border-radius: 50%;
		border-top-color: white;
		animation: spin 0.6s linear infinite;
		margin-right: 6px;
		vertical-align: middle;
	}
	
	/* Show spinner when HTMX request is in flight */
	.spinner.htmx-indicator.htmx-request {
		display: inline-block;
	}
	
	@keyframes spin {
		to { transform: rotate(360deg); }
	}
	
	/* Hidden class for collapsible elements */
	.hidden {
		display: none;
	}
</style>
	</head>
	<body>
		<div class="container">
		<div class="header">
			<h1>clai Model Benchmarks</h1>
			<p>Manage servers and test model performance</p>
		</div>
			{ children... }
		</div>
		
		<!-- Auto-reload on server restart during development -->
		<script>
			// Poll server health every 2 seconds
			let lastServerCheck = Date.now();
			let consecutiveFailures = 0;
			
			setInterval(async () => {
				try {
					const response = await fetch('/health', { 
						method: 'HEAD',
						cache: 'no-store'
					});
					if (response.ok) {
						// Server is up
						if (consecutiveFailures > 0) {
							// Server just came back up after being down - reload!
							console.log('Server restarted, reloading page...');
							window.location.reload();
						}
						consecutiveFailures = 0;
					} else {
						consecutiveFailures++;
					}
				} catch (e) {
					// Server might be restarting
					consecutiveFailures++;
				}
			}, 2000);
		</script>

		<!-- HTMX: Process dynamically loaded content -->
		<script>
			// When new content is loaded via HTMX, process it so hx-* attributes work
			document.body.addEventListener('htmx:load', function(evt) {
				console.log('HTMX loaded new content - processing forms');
				// Process all forms in the loaded element
				const forms = evt.detail.elt.querySelectorAll('form[hx-post], form[hx-delete]');
				forms.forEach(form => {
					console.log('Processing form:', form.getAttribute('hx-post') || form.getAttribute('hx-delete'));
					htmx.process(form);
				});
				
				// Attach memory estimation event listeners to all forms
				initMemoryEstimation();
			});
			
			// SSE Event Logging for Development/Debugging
			if (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1') {
				const sseEvents = ['htmx:sseOpen', 'htmx:sseError', 'htmx:sseClose', 'htmx:sseMessage', 'htmx:sseBeforeMessage'];
				sseEvents.forEach(function(eventName) {
					document.body.addEventListener(eventName, function(e) {
						const shortName = eventName.replace('htmx:', '');
						if (shortName === 'sseMessage') {
							// Log SSE messages with event type
							console.log('[SSE] Message received:', {
								event: e.detail.event || 'message',
								timestamp: new Date().toLocaleTimeString()
							});
						} else if (shortName === 'sseError') {
							console.error('[SSE] Error:', e.detail.error ? e.detail.error.message : 'unknown');
						} else if (shortName === 'sseOpen') {
							console.log('[SSE] Connection opened');
						} else if (shortName === 'sseClose') {
							console.log('[SSE] Connection closed');
						}
					});
				});
				console.log('[SSE] Debug logging enabled for localhost');
			}
			
			// Memory estimation for model loading
			function formatBytes(bytes) {
				if (bytes === 0) return '0 B';
				const k = 1024;
				const sizes = ['B', 'KB', 'MB', 'GB', 'TB'];
				const i = Math.floor(Math.log(bytes) / Math.log(k));
				return Math.round(bytes / Math.pow(k, i) * 10) / 10 + ' ' + sizes[i];
			}
			
			function estimateMemoryUsage(modelSizeBytes, contextSize, ngl, totalLayers) {
				// Model weights (proportional to GPU layers)
				const layerFraction = totalLayers > 0 ? (ngl / totalLayers) : 1.0;
				const modelWeightsGPU = modelSizeBytes * layerFraction;
				
				// KV cache: ~0.25 MB per token for large models (empirical)
				const kvCacheBytes = contextSize * 0.25 * 1024 * 1024;
				
				// Total GPU memory estimate
				const totalGPUBytes = modelWeightsGPU + kvCacheBytes;
				
				return {
					total: totalGPUBytes,
					modelWeights: modelWeightsGPU,
					kvCache: kvCacheBytes
				};
			}
			
			function updateMemoryEstimate(form) {
				const modelSizeBytes = parseInt(form.dataset.modelSize) || 0;
				const parametersCount = parseInt(form.dataset.parameters) || 0;
				
				// Estimate layers from parameters (rough heuristic: ~1B params per layer for large models)
				// For 78B model, typical layer count is 80-86
				const estimatedLayers = parametersCount > 0 ? Math.max(80, Math.round(parametersCount / 1e9)) : 80;
				
				const contextSelect = form.querySelector('select[name="context_size"]');
				const nglSelect = form.querySelector('select[name="ngl"]');
				const estimateDiv = form.querySelector('.memory-estimate');
				
				if (!contextSelect || !nglSelect || !estimateDiv || modelSizeBytes === 0) {
					return;
				}
				
				const contextValue = contextSelect.value || '131072';
				const nglValue = nglSelect.value || '999';
				
				const contextSize = parseInt(contextValue);
				const ngl = nglValue === '999' ? estimatedLayers : parseInt(nglValue);
				
				const estimate = estimateMemoryUsage(modelSizeBytes, contextSize, ngl, estimatedLayers);
				const totalGB = estimate.total / (1024 * 1024 * 1024);
				
				// Determine warning level
				let warningClass = '';
				let warningIcon = '';
				let warningText = '';
				
				if (totalGB > 128) {
					warningClass = 'error';
					warningIcon = '🔴';
					warningText = 'EXCEEDS SYSTEM LIMIT (128GB)';
				} else if (totalGB > 64) {
					warningClass = 'warning';
					warningIcon = '⚠️';
					warningText = 'May trigger ROCm >64GB bug';
				} else if (totalGB > 48) {
					warningClass = 'info';
					warningIcon = 'ℹ️';
					warningText = 'High memory usage';
				} else {
					warningClass = 'success';
					warningIcon = '✓';
					warningText = 'Safe range';
				}
				
				estimateDiv.innerHTML = `
					<div style="display: flex; align-items: center; gap: 8px; padding: 8px; background: rgba(30, 41, 59, 0.6); border-radius: 4px; border-left: 3px solid ${warningClass === 'error' ? '#ef4444' : warningClass === 'warning' ? '#f59e0b' : warningClass === 'info' ? '#3b82f6' : '#10b981'};">
						<span style="font-size: 16px;">${warningIcon}</span>
						<div style="flex: 1;">
							<div style="font-size: 13px; font-weight: 600; color: #e2e8f0;">
								Est. GPU Memory: ${formatBytes(estimate.total)} (~${totalGB.toFixed(1)} GB)
							</div>
							<div style="font-size: 11px; color: #94a3b8;">
								${warningText} • Layers: ${ngl}/${estimatedLayers} • Context: ${(contextSize/1024).toFixed(0)}K
							</div>
						</div>
					</div>
				`;
			}
			
			function initMemoryEstimation() {
				const forms = document.querySelectorAll('form[hx-post="/api/servers/start"]');
				forms.forEach(form => {
					const contextSelect = form.querySelector('select[name="context_size"]');
					const nglSelect = form.querySelector('select[name="ngl"]');
					
					if (contextSelect && nglSelect) {
						contextSelect.addEventListener('change', () => updateMemoryEstimate(form));
						nglSelect.addEventListener('change', () => updateMemoryEstimate(form));
						
						// Initial update
						updateMemoryEstimate(form);
					}
				});
			}
			
			// Initialize on page load
			document.addEventListener('DOMContentLoaded', initMemoryEstimation);
		</script>
	</body>
	</html>
}